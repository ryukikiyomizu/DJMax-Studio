<shell:StudioWindow x:Class="DJMaxEditor.Studio.Shell.ThemePickerWindow"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:DJMaxEditor.Studio.Shell"
                    xmlns:sh="clr-namespace:System.Windows;assembly=PresentationFramework"
                    Title="Chart themes"
                    Width="520" Height="560"
                    MinWidth="440" MinHeight="400"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner"
                    PreviewKeyDown="OnPreviewKeyDown"
                    Background="{StaticResource Brush.Abyss}"
                    Foreground="{StaticResource Brush.TextPrimary}"
                    FontFamily="{StaticResource Font.Ui}"
                    FontSize="{StaticResource Font.Size.Body}">

    <!--
        One list, one row per chart palette: name, what it is for, a strip of its own colours, and
        a dot on the one in use. Clicking a row applies that palette immediately, so the chart
        behind the window changes while the dialog is still open - which is the whole reason this
        is a dialog and not a toolbar dropdown. A name cannot tell you what an IIDX lane stagger
        looks like; seeing it on your own chart can.

        Non-modal and single-instance, exactly like PreferencesWindow: a modal dialog would still
        repaint the chart under it, but it would also stop you scrolling to the passage you care
        about before deciding.

        Row and column sizes are literals because Metric.* are sys:Double and WPF will not convert
        a Double resource to a GridLength.
    -->
    <Border Padding="{Binding MaximizedPadding, RelativeSource={RelativeSource AncestorType=shell:StudioWindow}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <!-- ============================ title bar ============================ -->
            <Border Grid.Row="0" Background="{StaticResource Brush.Raised}"
                    BorderBrush="{StaticResource Brush.Edge}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Style="{StaticResource Icon.Glyph}"
                          Data="{StaticResource Icon.Palette}"
                          Stroke="{StaticResource Brush.Accent}"
                          Margin="10,0,8,0" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1" Text="CHART THEMES"
                               FontFamily="{StaticResource Font.UiDisplay}"
                               FontSize="{StaticResource Font.Size.Small}"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="2" Style="{StaticResource Button.CaptionClose}"
                            Command="{x:Static sh:SystemCommands.CloseWindowCommand}"
                            ToolTip="Close (Esc)">
                        <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.X}" />
                    </Button>
                </Grid>
            </Border>

            <!-- ============================== list ============================== -->
            <ListBox Grid.Row="1" x:Name="ThemeList" Margin="10"
                     Background="{StaticResource Brush.Inset}"
                     BorderBrush="{StaticResource Brush.Edge}" BorderThickness="1"
                     SelectionChanged="OnThemeSelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Current-theme dot. Present on every row so the names all start at
                                 the same x whether or not the dot is lit. -->
                            <Ellipse Grid.Column="0" Width="8" Height="8"
                                     VerticalAlignment="Top" Margin="2,5,0,0"
                                     Fill="{Binding MarkerBrush}" />

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}"
                                           FontFamily="{StaticResource Font.UiDisplay}"
                                           FontSize="{StaticResource Font.Size.Body}"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Text="{Binding Description}"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           FontSize="{StaticResource Font.Size.Small}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />

                                <!-- The theme's own colours, so two rows can be compared without
                                     applying both. Which colours these are is the theme's call
                                     (StudioChartTheme.Swatches): a lane-coloured palette shows its
                                     lane roles, an attribute-coloured one its note families. -->
                                <ItemsControl ItemsSource="{Binding Swatches}" Margin="0,7,0,0"
                                              Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="22" Height="14" Margin="0,0,3,0"
                                                    Background="{Binding}"
                                                    BorderBrush="{StaticResource Brush.Edge}"
                                                    BorderThickness="1"
                                                    SnapsToDevicePixels="True" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ============================= footer ============================= -->
            <Border Grid.Row="2" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Edge}" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                               Style="{StaticResource Text.Readout}"
                               Foreground="{StaticResource Brush.TextMuted}"
                               TextWrapping="Wrap"
                               Text="Click a theme to use it right away; your choice is remembered. The TECHNIKA playfield keeps the arcade's own colours." />

                    <Button Grid.Column="1" Style="{StaticResource Button.Solid}"
                            VerticalAlignment="Center" IsDefault="True"
                            Command="{x:Static sh:SystemCommands.CloseWindowCommand}"
                            Content="Close" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</shell:StudioWindow>

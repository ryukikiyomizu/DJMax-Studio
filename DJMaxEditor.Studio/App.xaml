<Application x:Class="DJMaxEditor.Studio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Order matters: Palette defines the tokens that the others resolve
                     against with StaticResource, so it has to be merged first. Widgets comes
                     last for the same reason: it extends styles that Controls.xaml defines. -->
                <ResourceDictionary Source="/Theme/Palette.xaml" />
                <ResourceDictionary Source="/Theme/Icons.xaml" />
                <ResourceDictionary Source="/Theme/Controls.xaml" />
                <ResourceDictionary Source="/Theme/Widgets.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

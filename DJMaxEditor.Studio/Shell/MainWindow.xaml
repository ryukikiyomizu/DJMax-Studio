<shell:StudioWindow x:Class="DJMaxEditor.Studio.Shell.MainWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:DJMaxEditor.Studio.Shell"
                    xmlns:sh="clr-namespace:System.Windows;assembly=PresentationFramework"
                    Title="DJMax Studio"
                    Width="1500" Height="920"
                    MinWidth="1000" MinHeight="640"
                    Background="{StaticResource Brush.Abyss}"
                    Foreground="{StaticResource Brush.TextPrimary}"
                    FontFamily="{StaticResource Font.Ui}"
                    FontSize="{StaticResource Font.Size.Body}">

    <!--
        Layout, top to bottom: title bar, one toolbar row, the body, one status row.

        The body is the four-region dock that every tool of this class converges on. VOCALOID 6
        has exactly this shape (left track list, centre editor, right inspector, bottom parameter
        lane) and so does ptSequencer with its three regions plus a status strip. Nothing here
        floats or tabs: a chart is one document, and splitting attention across tab groups is what
        made the old layout feel arbitrary.

        GridLength values are literals rather than {StaticResource Metric.*} because the palette
        stores those as sys:Double and WPF will not convert a Double resource to a GridLength.
        Border Height/Width can and do use the resources.
    -->
    <Border Padding="{Binding MaximizedPadding, RelativeSource={RelativeSource AncestorType=shell:StudioWindow}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <!-- ============================ title bar ============================ -->
            <Border Grid.Row="0" Background="{StaticResource Brush.Raised}"
                    BorderBrush="{StaticResource Brush.Edge}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Style="{StaticResource Icon.Glyph}"
                          Data="{StaticResource Icon.Disc3}"
                          Stroke="{StaticResource Brush.Accent}"
                          Margin="10,0,8,0" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1" Text="DJMAX STUDIO"
                               FontFamily="{StaticResource Font.UiDisplay}"
                               FontSize="{StaticResource Font.Size.Small}"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />

                    <!-- Document name, centred and ellipsised. A long path must never push the
                         caption buttons off the window. -->
                    <TextBlock Grid.Column="2" x:Name="DocumentLabel"
                               Text="No chart open"
                               Foreground="{StaticResource Brush.TextMuted}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Caption}"
                                Command="{x:Static sh:SystemCommands.MinimizeWindowCommand}"
                                ToolTip="Minimise">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Minus}" />
                        </Button>
                        <Button Style="{StaticResource Button.Caption}"
                                Click="OnToggleMaximise" ToolTip="Maximise / restore">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Square}" />
                        </Button>
                        <Button Style="{StaticResource Button.CaptionClose}"
                                Command="{x:Static sh:SystemCommands.CloseWindowCommand}"
                                ToolTip="Close">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.X}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================ toolbar ============================ -->
            <Border Grid.Row="1" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Edge}" BorderThickness="0,0,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">

                        <!-- file -->
                        <Button Style="{StaticResource Button.Tool}" Click="OnNew" ToolTip="New chart (Ctrl+N)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.FilePlus}" />
                        </Button>
                        <Button Style="{StaticResource Button.Tool}" Click="OnOpen" ToolTip="Open chart (Ctrl+O)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.FolderOpen}" />
                        </Button>
                        <Button Style="{StaticResource Button.Tool}" Click="OnSave" ToolTip="Save chart as (Ctrl+S)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Save}" />
                        </Button>

                        <Separator />

                        <!-- edit -->
                        <Button Style="{StaticResource Button.Tool}" Click="OnUndo" ToolTip="Undo (Ctrl+Z)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Undo2}" />
                        </Button>
                        <Button Style="{StaticResource Button.Tool}" Click="OnRedo" ToolTip="Redo (Ctrl+Y)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Redo2}" />
                        </Button>
                        <Button Style="{StaticResource Button.Tool}" Click="OnCut" ToolTip="Cut (Ctrl+X)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Scissors}" />
                        </Button>
                        <Button Style="{StaticResource Button.Tool}" Click="OnCopy" ToolTip="Copy (Ctrl+C)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Copy}" />
                        </Button>
                        <Button Style="{StaticResource Button.Tool}" Click="OnPaste" ToolTip="Paste at playhead (Ctrl+V)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.ClipboardPaste}" />
                        </Button>

                        <Separator />

                        <!-- tool modes: ptSequencer's F5-F8, same order, same shortcuts -->
                        <ToggleButton x:Name="ToolSelect" Style="{StaticResource Toggle.Tool}"
                                      Click="OnToolSelect" IsChecked="True" ToolTip="Select (F5)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.MousePointer2}" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolAdd" Style="{StaticResource Toggle.Tool}"
                                      Click="OnToolAdd" ToolTip="Addition (F6)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.SquarePlus}" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolEdit" Style="{StaticResource Toggle.Tool}"
                                      Click="OnToolEdit" ToolTip="Edit: drag a note's edge to make it long (F7)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Pencil}" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolDelete" Style="{StaticResource Toggle.Tool}"
                                      Click="OnToolDelete" ToolTip="Delete (F8)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Eraser}" />
                        </ToggleButton>

                        <Separator />

                        <!-- transport -->
                        <Button Style="{StaticResource Button.Tool}" Click="OnReturnToStart" ToolTip="Return to start (Home)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.SkipBack}" />
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource Button.Tool}" Click="OnPlayPause"
                                ToolTip="Start / pause preview (Space)">
                            <Path x:Name="PlayGlyph" Style="{StaticResource Icon.Glyph}"
                                  Data="{StaticResource Icon.Play}" Stroke="{StaticResource Brush.Accent}" />
                        </Button>
                        <Button Style="{StaticResource Button.Tool}" Click="OnPlayFromSpot" ToolTip="Play from the playhead (Enter)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.FastForward}" />
                        </Button>
                        <Button Style="{StaticResource Button.Tool}" Click="OnStop" ToolTip="Stop (Esc)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Square}" />
                        </Button>
                        <ToggleButton x:Name="FollowToggle" Style="{StaticResource Toggle.Tool}"
                                      Click="OnToggleFollow" IsChecked="True"
                                      ToolTip="Follow the playhead while playing">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Magnet}" />
                        </ToggleButton>

                        <Separator />

                        <!-- grid + detailed grid: ptSequencer's two combos -->
                        <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Grid3x3}"
                              Margin="4,0,4,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="GridCombo" Width="72" SelectionChanged="OnGridChanged"
                                  ToolTip="Grid: notes snap to this division of a bar" />
                        <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Ruler}"
                              Margin="8,0,4,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="BeatCombo" Width="64" SelectionChanged="OnBeatChanged"
                                  ToolTip="Detailed grid: which subdivision gets a drawn line. Never snaps." />

                        <Separator />

                        <!-- track preset (key mode) -->
                        <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Columns3}"
                              Margin="4,0,4,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="PresetCombo" Width="128" SelectionChanged="OnPresetChanged"
                                  ToolTip="Track preset: the lane layout, from ptSequencer's .pst files" />

                        <Separator />

                        <!-- view -->
                        <ToggleButton x:Name="LabelsToggle" Style="{StaticResource Toggle.Tool}"
                                      Click="OnToggleLabels"
                                      ToolTip="Show keysound names inside notes (costs frame time)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Music4}" />
                        </ToggleButton>
                        <ToggleButton x:Name="AssetsToggle" Style="{StaticResource Toggle.Tool}"
                                      Click="OnToggleAssets" IsChecked="True"
                                      ToolTip="Draw notes as arcade art instead of plain rectangles">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Image}" />
                        </ToggleButton>
                        <ToggleButton x:Name="DirectionToggle" Style="{StaticResource Toggle.Tool}"
                                      Click="OnToggleDirection" IsChecked="True"
                                      ToolTip="Time runs upward, the way the game scrolls">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.ChevronUp}" />
                        </ToggleButton>
                        <!-- Orientation, not a second canvas: the same surface reflected across its
                             diagonal, so time runs across the screen and lanes down it. TECHNIKA
                             reads that way - a scan sweeps sideways - and so does every DAW. -->
                        <ToggleButton x:Name="OrientationToggle" Style="{StaticResource Toggle.Tool}"
                                      Click="OnToggleOrientation"
                                      ToolTip="Time runs down the screen (ptSequencer layout)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.MoveHorizontal}" />
                        </ToggleButton>
                        <Button Style="{StaticResource Button.Tool}" Click="OnZoomIn" ToolTip="Zoom in (Ctrl+wheel)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.ZoomIn}" />
                        </Button>
                        <Button Style="{StaticResource Button.Tool}" Click="OnZoomOut" ToolTip="Zoom out (Ctrl+wheel)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.ZoomOut}" />
                        </Button>
                        <Button Style="{StaticResource Button.Tool}" Click="OnFitColumns" ToolTip="Fit all lanes to the window">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Maximize2}" />
                        </Button>

                        <Separator />

                        <ToggleButton x:Name="LeftDockToggle" Style="{StaticResource Toggle.Tool}"
                                      Click="OnToggleLeftDock" IsChecked="True" ToolTip="Show the track and sample panel">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.PanelLeft}" />
                        </ToggleButton>
                        <ToggleButton x:Name="RightDockToggle" Style="{StaticResource Toggle.Tool}"
                                      Click="OnToggleRightDock" IsChecked="True" ToolTip="Show the inspector">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.PanelRight}" />
                        </ToggleButton>
                        <ToggleButton x:Name="VolumeLaneToggle" Style="{StaticResource Toggle.Tool}"
                                      Click="OnToggleVolumeLane" IsChecked="True" ToolTip="Show the note-volume lane">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.SlidersHorizontal}" />
                        </ToggleButton>
                        <ToggleButton x:Name="BgaToggle" Style="{StaticResource Toggle.Tool}"
                                      Click="OnToggleBga" ToolTip="Show the BGA preview">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.MonitorPlay}" />
                        </ToggleButton>
                        <!-- Rows, not columns: TECHNIKA's field is two horizontal halves, which is
                             the one thing about it you cannot see on a tick-axis canvas. -->
                        <ToggleButton x:Name="PlayfieldToggle" Style="{StaticResource Toggle.Tool}"
                                      Click="OnTogglePlayfield" ToolTip="Show the TECHNIKA gameplay playfield">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Rows3}" />
                        </ToggleButton>

                        <Separator />

                        <!-- Last in the bar and behind its own separator: everything to the left of
                             it acts on this chart, this one acts on the editor. -->
                        <Button x:Name="PreferencesButton" Style="{StaticResource Button.Tool}"
                                Click="OnOpenPreferences" ToolTip="Preferences (Ctrl+,)">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Settings}" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============================= body ============================= -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftDockColumn" Width="252" MinWidth="180" />
                    <ColumnDefinition x:Name="LeftSplitterColumn" Width="4" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition x:Name="RightSplitterColumn" Width="4" />
                    <ColumnDefinition x:Name="RightDockColumn" Width="288" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <!-- left dock -->
                <Grid x:Name="LeftDock" Grid.Column="0" Background="{StaticResource Brush.Surface}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- View Options: ptSequencer's own sliders, same intent -->
                    <StackPanel Grid.Row="0" Margin="10,8,10,10">
                        <TextBlock Text="VIEW OPTIONS" Style="{StaticResource Text.Section}" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Track width"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       FontSize="{StaticResource Font.Size.Small}" />
                            <TextBlock Grid.Column="1" x:Name="TrackWidthReadout" Text="1.00x"
                                       Style="{StaticResource Text.Readout}"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                        </Grid>
                        <Slider x:Name="TrackWidthSlider" Minimum="0.55" Maximum="2.0" Value="1.0"
                                ValueChanged="OnTrackWidthChanged" />

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Note height"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       FontSize="{StaticResource Font.Size.Small}" />
                            <TextBlock Grid.Column="1" x:Name="NoteHeightReadout" Text="0.55"
                                       Style="{StaticResource Text.Readout}"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                        </Grid>
                        <Slider x:Name="NoteHeightSlider" Minimum="0.05" Maximum="4.0" Value="0.55"
                                ValueChanged="OnNoteHeightChanged" />
                    </StackPanel>

                    <Border Grid.Row="1" Height="1" Background="{StaticResource Brush.Edge}" />

                    <!-- Sample list: ptSequencer's numbered keysound table -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="10,8,10,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SAMPLES" Style="{StaticResource Text.Section}" />
                            <TextBlock Grid.Column="1" x:Name="SampleCount" Text="0"
                                       Style="{StaticResource Text.Readout}"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="SampleList" Margin="4,0,4,4"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 MouseDoubleClick="OnSampleDoubleClick"
                                 ToolTip="Double-click to audition a keysound">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding InsNum}"
                                                   Style="{StaticResource Text.Readout}"
                                                   Foreground="{StaticResource Brush.TextMuted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                <GridSplitter x:Name="LeftSplitter" Grid.Column="1" HorizontalAlignment="Stretch" />

                <!-- centre -->
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition x:Name="VolumeSplitterColumn" Width="4" />
                        <ColumnDefinition x:Name="VolumeLaneColumn" Width="92" MinWidth="48" />
                    </Grid.ColumnDefinitions>
                    <!-- Both axes are defined and only one is ever open. Which one holds the volume
                         lane is the orientation's business (OnToggleOrientation -> DockVolumeLane);
                         the closed axis sits at zero so the canvas has the whole cell. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition x:Name="VolumeSplitterRow" Height="0" />
                        <RowDefinition x:Name="VolumeLaneRow" Height="0" MinHeight="0" />
                    </Grid.RowDefinitions>

                    <!-- The chart canvas is added here from code-behind: it is an internal type,
                         and it needs its own event wiring anyway.
                         The column scrollbar shares the cell rather than taking a row of the grid
                         above, so it stays glued to the canvas whichever axis the volume lane docks
                         on. Which edge it sits on is the orientation's business as well: lanes run
                         across the bottom in the ptSequencer reading and down the side transposed
                         (TimelineColumnScroll.ApplyOrientation -> PlaceColumnScroll). -->
                    <Grid x:Name="CanvasCell" Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CanvasHost" Grid.Row="0" Grid.Column="0"
                                Background="{StaticResource Brush.Abyss}" ClipToBounds="True" />
                        <ScrollBar x:Name="ColumnScroll" Grid.Row="1" Grid.Column="0"
                                   Orientation="Horizontal" Visibility="Collapsed" />
                    </Grid>

                    <GridSplitter x:Name="VolumeSplitter" Grid.Row="0" Grid.Column="1"
                                  ResizeDirection="Columns"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                    <!-- Volume lane. V6 docks its VolumeLane/PanpotLane *under* the track because
                         V6's time axis is horizontal; vertically ours runs down the screen, so the
                         same lane has to sit beside the canvas to share the Y axis - and transposed
                         it moves under it, for the same reason and to the same place V6 keeps it.
                         A parameter lane that does not share the time axis with the notes it edits
                         is decoration.
                         It draws its own 22-px top strip rather than getting one from a Grid row,
                         so its note rows line up with the canvas body without anyone having to
                         keep two header heights in sync. -->
                    <Border x:Name="VolumeLaneHost" Grid.Row="0" Grid.Column="2" ClipToBounds="True"
                            Background="{StaticResource Brush.Surface}" />
                </Grid>

                <GridSplitter x:Name="RightSplitter" Grid.Column="3" HorizontalAlignment="Stretch" />

                <!-- right dock -->
                <Grid x:Name="RightDock" Grid.Column="4" Background="{StaticResource Brush.Surface}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- BGA preview. ptSequencer distinguishes a Play Screen from a Background
                         Screen, and every .pst preset dedicates songtrack 1 to BGA SYNC, so the
                         BGA is part of the chart rather than a decoration. -->
                    <Grid x:Name="BgaPanel" Grid.Row="0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource Brush.Raised}"
                                BorderBrush="{StaticResource Brush.Edge}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Style="{StaticResource Icon.Glyph}"
                                      Data="{StaticResource Icon.Film}" Margin="8,0,6,0" />
                                <TextBlock Grid.Column="1" Text="BGA" Style="{StaticResource Text.Section}"
                                           Margin="0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" x:Name="BgaStatus" Text="no video loaded"
                                           Style="{StaticResource Text.Readout}"
                                           Foreground="{StaticResource Brush.TextDisabled}"
                                           TextTrimming="CharacterEllipsis" Margin="10,0,4,0" />
                                <Button Grid.Column="3" Style="{StaticResource Button.Tool}"
                                        Width="24" Height="22" Click="OnLoadBga"
                                        ToolTip="Load a BGA video for this chart">
                                    <Path Style="{StaticResource Icon.Glyph}" Width="13" Height="13"
                                          Data="{StaticResource Icon.FolderOpen}" />
                                </Button>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" x:Name="BgaHost" Height="158"
                                Background="Black" ClipToBounds="True" />
                    </Grid>

                    <!-- TECHNIKA gameplay playfield. TECHNIKA does not scroll: the screen is two
                         halves, a scan sweeps the upper one left to right and the next sweeps the
                         lower one right to left, and a note's horizontal position *is* its position
                         in time within that scan. None of that is visible on a tick-axis canvas, so
                         a chart author working on a .pt has no way to see what they are authoring
                         without this. It appears only for TECHNIKA charts. -->
                    <Grid x:Name="PlayfieldPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource Brush.Raised}"
                                BorderBrush="{StaticResource Brush.Edge}" BorderThickness="0,1,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Style="{StaticResource Icon.Glyph}"
                                      Data="{StaticResource Icon.Rows3}" Margin="8,0,6,0" />
                                <TextBlock Grid.Column="1" Text="PLAYFIELD" Style="{StaticResource Text.Section}"
                                           Margin="0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" x:Name="PlayfieldStatus" Text="no chart loaded"
                                           Style="{StaticResource Text.Readout}"
                                           Foreground="{StaticResource Brush.TextDisabled}"
                                           TextTrimming="CharacterEllipsis" Margin="10,0,8,0" />
                            </Grid>
                        </Border>
                        <!-- No fixed height: the view measures itself to the arcade's 1280x768
                             aspect, so the panel is exactly as tall as the dock is wide and never
                             shows letterbox bars. -->
                        <Border Grid.Row="1" x:Name="PlayfieldHost"
                                Background="Black" ClipToBounds="True" />
                    </Grid>

                    <!-- Inspector -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource Brush.Raised}"
                                BorderBrush="{StaticResource Brush.Edge}" BorderThickness="0,1,0,1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Layers}"
                                      Margin="8,0,6,0" />
                                <TextBlock Text="INSPECTOR" Style="{StaticResource Text.Section}"
                                           Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="10,10,10,10">
                                <TextBlock x:Name="InspectorSelection" Text="Nothing selected"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           TextWrapping="Wrap" />

                                <!-- Round-3 item 12. The Core already has SetSelectionVolume and
                                     AdjustSelectionVolume with undo grouping, so this is a slider
                                     over an existing edit, not a new feature in the model. -->
                                <TextBlock Text="NOTE VOLUME" Style="{StaticResource Text.Section}"
                                           Margin="0,16,0,2" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" x:Name="VolumeSlider" Minimum="0" Maximum="127"
                                            Value="127" IsEnabled="False"
                                            ValueChanged="OnVolumeChanged" />
                                    <TextBlock Grid.Column="1" x:Name="VolumeReadout" Text="--"
                                               Style="{StaticResource Text.Readout}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>

                                <TextBlock Text="CHART" Style="{StaticResource Text.Section}" Margin="0,18,0,2" />
                                <TextBlock x:Name="InspectorChart" Text="--"
                                           Style="{StaticResource Text.Readout}"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="LANE" Style="{StaticResource Text.Section}" Margin="0,18,0,2" />
                                <TextBlock x:Name="InspectorLane" Text="--"
                                           Style="{StaticResource Text.Readout}"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Performance meter. V6 ships one; a tool whose entire complaint history is
                         about frame time has no business hiding its own. Named so Preferences can
                         collapse the strip - the row is Auto, so hiding the border reclaims it. -->
                    <Border x:Name="PerfReadoutPanel" Grid.Row="3"
                            Background="{StaticResource Brush.Raised}"
                            BorderBrush="{StaticResource Brush.Edge}" BorderThickness="0,1,0,0"
                            Padding="10,5">
                        <TextBlock x:Name="PerfReadout" Text="idle"
                                   Style="{StaticResource Text.Readout}"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                    </Border>
                </Grid>
            </Grid>

            <!-- ============================ status bar ============================ -->
            <Border Grid.Row="3" Background="{StaticResource Brush.Raised}"
                    BorderBrush="{StaticResource Brush.Edge}" BorderThickness="0,1,0,0">
                <!-- ptSequencer's status row reads "SEL:0 GRID:0 | TOT:0 | 0:0.0 / 0.0 sec".
                     Same fields, same order, so a ptSequencer user reads it without relearning. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock x:Name="StatusSelection" Text="SEL 0" Style="{StaticResource Text.Readout}" />
                    <TextBlock Text=" | " Foreground="{StaticResource Brush.TextDisabled}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusGrid" Text="GRID 1/16" Style="{StaticResource Text.Readout}" />
                    <TextBlock Text=" | " Foreground="{StaticResource Brush.TextDisabled}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusTotal" Text="TOT 0" Style="{StaticResource Text.Readout}" />
                    <TextBlock Text=" | " Foreground="{StaticResource Brush.TextDisabled}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusTime" Text="0:00.0 / 0:00.0" Style="{StaticResource Text.Readout}" />
                    <TextBlock Text=" | " Foreground="{StaticResource Brush.TextDisabled}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusTool" Text="SELECT" Style="{StaticResource Text.Readout}"
                               Foreground="{StaticResource Brush.Accent}" />
                    <TextBlock Text=" | " Foreground="{StaticResource Brush.TextDisabled}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusZoom" Text="ZOOM 100%" Style="{StaticResource Text.Readout}" />
                    <TextBlock Text=" | " Foreground="{StaticResource Brush.TextDisabled}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusHint" Text="Open a chart to begin"
                               Style="{StaticResource Text.Readout}"
                               Foreground="{StaticResource Brush.TextMuted}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</shell:StudioWindow>

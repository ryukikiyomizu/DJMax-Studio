<shell:StudioWindow x:Class="DJMaxEditor.Studio.Keyslicer.BmsImportPreviewWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:DJMaxEditor.Studio.Shell"
                    xmlns:sh="clr-namespace:System.Windows;assembly=PresentationFramework"
                    Title="Import BMS/BMSE/iBMSC — preview"
                    Width="720" Height="540"
                    MinWidth="620" MinHeight="420"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner"
                    Background="{StaticResource Brush.Abyss}"
                    Foreground="{StaticResource Brush.TextPrimary}"
                    FontFamily="{StaticResource Font.Ui}"
                    FontSize="12">
    <Border Padding="{Binding MaximizedPadding, RelativeSource={RelativeSource AncestorType=shell:StudioWindow}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource Brush.Raised}" BorderBrush="{StaticResource Brush.Edge}" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleDrag">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.ClipboardPaste}" Stroke="{StaticResource Brush.Accent}" Margin="10,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="IMPORT PREVIEW" FontFamily="{StaticResource Font.UiDisplay}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Style="{StaticResource Button.CaptionClose}" Command="{x:Static sh:SystemCommands.CloseWindowCommand}"><Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.X}"/></Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Edge}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SummaryLine" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="BpmLine" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                            <TextBlock x:Name="SlotsLine" Foreground="{StaticResource Brush.TextMuted}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="WavCount" Foreground="{StaticResource Brush.TextSecondary}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="NoteCount" Foreground="{StaticResource Brush.Accent}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" x:Name="WarningsBlock" TextWrapping="Wrap" Foreground="#E8A82A" FontSize="11" Margin="0,8,0,0" Visibility="Collapsed"/>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="{StaticResource Brush.Edge}" BorderThickness="1" CornerRadius="6" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="WAV MAP (base-36 id → filename)" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" FontWeight="SemiBold"/>
                            <ListBox Grid.Row="1" x:Name="WavList" Margin="0,6,0,0" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="10" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="{StaticResource Brush.Edge}" BorderThickness="1" CornerRadius="6" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="NOTES (first 200 sorted by time)" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" FontWeight="SemiBold"/>
                            <ListBox Grid.Row="1" x:Name="NoteList" Margin="0,6,0,0" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="10" />
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="3" Text="Import creates placeholder slices per distinct WAV (500 ms, label shows WAVxx) and chart notes at the imported times/lanes. If the .wav files sit beside the .bms, they become real sources; otherwise the slice is virtual until you re-slice the long take. Duplicate filenames are kept per id to avoid silent 008 reuse." TextWrapping="Wrap" Foreground="{StaticResource Brush.TextDisabled}" FontSize="10" Margin="0,8,0,0"/>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Edge}" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Style="{StaticResource Button.Solid}" Content="Cancel" Width="86" Margin="0,0,8,0" VerticalAlignment="Center" IsCancel="True"/>
                    <Button Grid.Column="2" Style="{StaticResource Button.Accent}" Width="160" VerticalAlignment="Center" IsDefault="True" Click="OnImport">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.ClipboardPaste}" Margin="0,0,6,0"/>
                            <TextBlock Text="Import into slicer"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</shell:StudioWindow>

<shell:StudioWindow x:Class="DJMaxEditor.Studio.Keyslicer.KeyslicerFinalizeWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:DJMaxEditor.Studio.Shell"
                    xmlns:sh="clr-namespace:System.Windows;assembly=PresentationFramework"
                    Title="Finalize — export slices"
                    Width="640" Height="520"
                    MinWidth="600" MinHeight="480"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner"
                    Background="{StaticResource Brush.Abyss}"
                    Foreground="{StaticResource Brush.TextPrimary}"
                    FontFamily="{StaticResource Font.Ui}"
                    FontSize="12">
    <Border Padding="{Binding MaximizedPadding, RelativeSource={RelativeSource AncestorType=shell:StudioWindow}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Brush.Raised}" BorderBrush="{StaticResource Brush.Edge}" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleDrag">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Save}" Stroke="{StaticResource Brush.Accent}" Margin="10,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="FINALIZE" FontFamily="{StaticResource Font.UiDisplay}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Style="{StaticResource Button.CaptionClose}" Command="{x:Static sh:SystemCommands.CloseWindowCommand}"><Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.X}"/></Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Turn virtual slices into real audio + chart" FontFamily="{StaticResource Font.UiDisplay}" FontSize="14" Margin="0,0,0,4"/>
                    <TextBlock Text="Until you Finalize, slices are just {source, startMs, endMs} — no files on disk, ks_0001 stays stable even if you re-slice. Finalize is the only moment we render WAV/OGG and write the .tech. Traditional BMS would have hundreds of tiny files from the start; this keeps the long source intact until you're sure." TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,0,0,12"/>

                    <!-- Budget review -->
                    <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Edge}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="BUDGET" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextMuted}"/>
                            <TextBlock Grid.Column="1" x:Name="BudgetBadge" FontSize="10" Foreground="{StaticResource Brush.TextMuted}"/>
                            <TextBlock Grid.Row="1" x:Name="BudgetLabel" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"/>
                            <Border Grid.Row="1" Grid.Column="1" Height="10" Width="120" CornerRadius="5" Background="{StaticResource Brush.Abyss}" BorderBrush="{StaticResource Brush.Edge}" BorderThickness="1" Margin="8,4,0,0">
                                <Border x:Name="BudgetFill" HorizontalAlignment="Left" CornerRadius="5" Width="0"/>
                            </Border>
                            <TextBlock Grid.Row="2" x:Name="BudgetHint" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Slice list summary -->
                    <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Edge}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="SLICES" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextMuted}"/>
                            <TextBlock x:Name="SliceSummary" Text="0 slices" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0"/>
                            <ListBox x:Name="SlicePreview" MaxHeight="120" Margin="0,6,0,0" BorderBrush="{StaticResource Brush.Edge}" BorderThickness="1" Background="Transparent" FontFamily="Consolas" FontSize="10"/>
                            <TextBlock x:Name="OverBudgetWarning" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF6B6B"/>
                        </StackPanel>
                    </Border>

                    <!-- Export options -->
                    <TextBlock Text="EXPORT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextMuted}" Margin="0,14,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Format" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="FormatCombo" Width="140" HorizontalAlignment="Left">
                            <ComboBoxItem Content="WAV (PCM, lossless)" Tag="wav" IsSelected="True"/>
                            <ComboBoxItem Content="OGG Vorbis (smaller)" Tag="ogg"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="NormalizeCheck" Content="Peak-normalize each slice (so keysounds have even loudness)" Margin="0,8,0,0"/>
                    <CheckBox x:Name="OnlyUsedCheck" Content="Export only slices that have a chart note" IsChecked="True" Margin="0,6,0,0"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Output folder" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="FolderBox" IsReadOnly="True" Background="{StaticResource Brush.Inset}"/>
                        <Button Grid.Column="2" Style="{StaticResource Button.Solid}" Content="Browse..." Margin="6,0,0,0" Click="OnBrowse"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Chart (.tech)" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <CheckBox x:Name="WriteTechCheck" Content="Also write track.tech beside the slices" IsChecked="True" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TechNote" Text="needs at least one placed note" Foreground="{StaticResource Brush.TextMuted}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="After Finalize you'll get a folder you can open directly as a Techmania track (move the whole folder), or use Send to Editor if a chart is already open." TextWrapping="Wrap" Foreground="{StaticResource Brush.TextDisabled}" FontSize="10" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Edge}" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Style="{StaticResource Button.Solid}" Content="Cancel" Width="86" Margin="0,0,8,0" VerticalAlignment="Center" IsCancel="True"/>
                    <Button Grid.Column="2" Style="{StaticResource Button.Accent}" Width="140" VerticalAlignment="Center" IsDefault="True" Click="OnFinalize">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Style="{StaticResource Icon.Glyph}" Data="{StaticResource Icon.Save}" Margin="0,0,6,0"/>
                            <TextBlock Text="Finalize"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</shell:StudioWindow>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Supplemental widget layer, merged after Controls.xaml.

        Controls.xaml already owns the implicit dark styles for the stock controls the shell puts
        on screen: ComboBox, ComboBoxItem, Slider, ScrollBar, ScrollViewer, ListBox, ListBoxItem,
        Separator, ToolTip, GridSplitter, TextBox, CheckBox, Button and TextBlock. Restating any
        of those here would not extend them - a keyless style in a later merged dictionary
        replaces the earlier one outright rather than merging with it - so this file deliberately
        carries only what Controls.xaml leaves uncovered. Adding a widget style here is correct;
        copying one down from Controls.xaml is not.

        Styles here reach Palette tokens, and keyed styles in Controls.xaml, through the merged
        dictionary chain that App.xaml sets up, so the merge order there is load-bearing for this
        file exactly as it is for Controls.xaml.
    -->

    <!-- ==== toggle button ==============================================================
         Controls.xaml styles ToggleButton only through the keyed Toggle.Tool, which is a fixed
         28x28 icon square for the toolbar. A ToggleButton with no explicit style therefore still
         falls through to Aero2, whose ButtonChrome paints a light-grey gradient that no property
         setter can recolour - so a stray toggle reads as a Windows 7 button on a near-black
         shell. This is the content-sized counterpart: same flat vocabulary, but it honours
         Padding so a toggle carrying a text label is not cramped, and it leaves Width and Height
         to the layout.

         It carries its own template rather than deriving from Button.Base because the latched
         state has to be a template trigger declared after IsMouseOver. Adding IsChecked as a
         style-level trigger on top of Button.Base loses that ordering: Button.Base sets the hover
         fill from inside its template, which outranks a value coming from the styled control, so
         a latched toggle would drop its accent the moment the cursor crossed it. Toggle.Tool
         resolves the same conflict the same way. -->
    <Style TargetType="{x:Type ToggleButton}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Metric.CornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Inset}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Edge}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.AccentGhost}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.AccentDim}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
